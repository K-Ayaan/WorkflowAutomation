<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_LeaveApproval"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   exporter="Claude"
                   exporterVersion="1.0">

  <bpmn:process id="Process_EmployeeLeaveApproval" name="Employee Leave Approval" isExecutable="true">

    <bpmn:startEvent id="StartEvent_LeaveRequestSubmitted" name="Leave Request Submitted">
      <bpmn:outgoing>Flow_StartToCheckBalance</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CheckLeaveBalance" name="Check Leave Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToCheckBalance</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckBalanceToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_SufficientBalance" name="Sufficient Balance?">
      <bpmn:incoming>Flow_CheckBalanceToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SufficientToManager</bpmn:outgoing>
      <bpmn:outgoing>Flow_InsufficientToNotif</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManagerApproval" name="Manager Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SufficientToManager</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerToDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Decision">
      <bpmn:incoming>Flow_ManagerToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovedToUpdateBalance</bpmn:outgoing>
      <bpmn:outgoing>Flow_RejectedToNotif</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_UpdateLeaveBalance" name="Update Leave Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovedToUpdateBalance</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateBalanceToApprovalNotif</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendApprovalNotification" name="Send Approval Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-approval-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UpdateBalanceToApprovalNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalNotifToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendRejectionNotification" name="Send Rejection Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RejectedToNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectionNotifToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendInsufficientBalanceNotification" name="Send Insufficient Balance Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-insufficient-balance-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InsufficientToNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_InsufficientNotifToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_LeaveApproved" name="Leave Approved">
      <bpmn:incoming>Flow_ApprovalNotifToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_LeaveRejected" name="Leave Rejected">
      <bpmn:incoming>Flow_RejectionNotifToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_InsufficientBalance" name="Insufficient Balance">
      <bpmn:incoming>Flow_InsufficientNotifToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToCheckBalance" sourceRef="StartEvent_LeaveRequestSubmitted" targetRef="Task_CheckLeaveBalance" />
    <bpmn:sequenceFlow id="Flow_CheckBalanceToGateway" sourceRef="Task_CheckLeaveBalance" targetRef="Gateway_SufficientBalance" />

    <bpmn:sequenceFlow id="Flow_SufficientToManager" name="Sufficient" sourceRef="Gateway_SufficientBalance" targetRef="Task_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sufficientBalance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_InsufficientToNotif" name="Insufficient" sourceRef="Gateway_SufficientBalance" targetRef="Task_SendInsufficientBalanceNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sufficientBalance = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ManagerToDecisionGateway" sourceRef="Task_ManagerApproval" targetRef="Gateway_ManagerDecision" />

    <bpmn:sequenceFlow id="Flow_ApprovedToUpdateBalance" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_UpdateLeaveBalance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_RejectedToNotif" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_SendRejectionNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_UpdateBalanceToApprovalNotif" sourceRef="Task_UpdateLeaveBalance" targetRef="Task_SendApprovalNotification" />
    <bpmn:sequenceFlow id="Flow_ApprovalNotifToEnd" sourceRef="Task_SendApprovalNotification" targetRef="EndEvent_LeaveApproved" />
    <bpmn:sequenceFlow id="Flow_RejectionNotifToEnd" sourceRef="Task_SendRejectionNotification" targetRef="EndEvent_LeaveRejected" />
    <bpmn:sequenceFlow id="Flow_InsufficientNotifToEnd" sourceRef="Task_SendInsufficientBalanceNotification" targetRef="EndEvent_InsufficientBalance" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_EmployeeLeaveApproval">

      <bpmndi:BPMNShape id="StartEvent_LeaveRequestSubmitted_di" bpmnElement="StartEvent_LeaveRequestSubmitted">
        <omgdc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="130" y="245" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckLeaveBalance_di" bpmnElement="Task_CheckLeaveBalance">
        <omgdc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_SufficientBalance_di" bpmnElement="Gateway_SufficientBalance" isMarkerVisible="true">
        <omgdc:Bounds x="395" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="378" y="252" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ManagerApproval_di" bpmnElement="Task_ManagerApproval">
        <omgdc:Bounds x="500" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
        <omgdc:Bounds x="655" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="638" y="252" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UpdateLeaveBalance_di" bpmnElement="Task_UpdateLeaveBalance">
        <omgdc:Bounds x="760" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendApprovalNotification_di" bpmnElement="Task_SendApprovalNotification">
        <omgdc:Bounds x="910" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_LeaveApproved_di" bpmnElement="EndEvent_LeaveApproved">
        <omgdc:Bounds x="1062" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1040" y="125" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendRejectionNotification_di" bpmnElement="Task_SendRejectionNotification">
        <omgdc:Bounds x="760" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_LeaveRejected_di" bpmnElement="EndEvent_LeaveRejected">
        <omgdc:Bounds x="912" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="890" y="365" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendInsufficientBalanceNotification_di" bpmnElement="Task_SendInsufficientBalanceNotification">
        <omgdc:Bounds x="395" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_InsufficientBalance_di" bpmnElement="EndEvent_InsufficientBalance">
        <omgdc:Bounds x="577" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="555" y="445" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_StartToCheckBalance_di" bpmnElement="Flow_StartToCheckBalance">
        <omgdi:waypoint x="188" y="220" />
        <omgdi:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CheckBalanceToGateway_di" bpmnElement="Flow_CheckBalanceToGateway">
        <omgdi:waypoint x="340" y="220" />
        <omgdi:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SufficientToManager_di" bpmnElement="Flow_SufficientToManager">
        <omgdi:waypoint x="445" y="220" />
        <omgdi:waypoint x="500" y="220" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="455" y="202" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_InsufficientToNotif_di" bpmnElement="Flow_InsufficientToNotif">
        <omgdi:waypoint x="420" y="245" />
        <omgdi:waypoint x="420" y="380" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="425" y="300" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ManagerToDecisionGateway_di" bpmnElement="Flow_ManagerToDecisionGateway">
        <omgdi:waypoint x="600" y="220" />
        <omgdi:waypoint x="655" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ApprovedToUpdateBalance_di" bpmnElement="Flow_ApprovedToUpdateBalance">
        <omgdi:waypoint x="680" y="195" />
        <omgdi:waypoint x="680" y="100" />
        <omgdi:waypoint x="760" y="100" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="686" y="140" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RejectedToNotif_di" bpmnElement="Flow_RejectedToNotif">
        <omgdi:waypoint x="680" y="245" />
        <omgdi:waypoint x="680" y="340" />
        <omgdi:waypoint x="760" y="340" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="686" y="290" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_UpdateBalanceToApprovalNotif_di" bpmnElement="Flow_UpdateBalanceToApprovalNotif">
        <omgdi:waypoint x="860" y="100" />
        <omgdi:waypoint x="910" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ApprovalNotifToEnd_di" bpmnElement="Flow_ApprovalNotifToEnd">
        <omgdi:waypoint x="1010" y="100" />
        <omgdi:waypoint x="1062" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_RejectionNotifToEnd_di" bpmnElement="Flow_RejectionNotifToEnd">
        <omgdi:waypoint x="860" y="340" />
        <omgdi:waypoint x="912" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_InsufficientNotifToEnd_di" bpmnElement="Flow_InsufficientNotifToEnd">
        <omgdi:waypoint x="515" y="420" />
        <omgdi:waypoint x="577" y="420" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
