<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
 id="Definitions_EmployeeLeave"
 targetNamespace="http://xyzcorp.example/employee-leave">

  <bpmn:process id="EmployeeLeaveApproval" name="Employee Leave Request Approval" isExecutable="true">

    <bpmn:startEvent id="StartEvent_LeaveRequest" name="Leave Request Submitted">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SubmitLeave" name="Submit Leave Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="leave-request-form"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="Task_LeaveDecision" name="Evaluate Leave Request">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="LeaveApprovalDecision" resultVariable="leaveDecision"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Leave Decision">
      <bpmn:incoming>Flow_DecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Insufficient</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_InsufficientBalance" name="Notify Employee: Insufficient Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-leave-rejection"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Insufficient</bpmn:incoming>
      <bpmn:outgoing>Flow_Insufficient_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Insufficient" name="Rejected - Insufficient Balance">
      <bpmn:incoming>Flow_Insufficient_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_ManagerApproval" name="Manager Review &amp; Approval">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assigneeExpression="=managerId"/>
        <zeebe:formDefinition formKey="manager-leave-approval-form"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManagerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Approved?">
      <bpmn:incoming>Flow_ManagerGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ManagerRejectedNotify" name="Notify Employee: Leave Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-leave-rejection"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManagerRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerRejected_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_ManagerRejected" name="Rejected by Manager">
      <bpmn:incoming>Flow_ManagerRejected_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_HRRecord" name="Forward Request to HR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hr-record-leave"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManagerApproved</bpmn:incoming>
      <bpmn:incoming>Flow_AutoApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_Balance</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateBalance" name="Update Employee Leave Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-leave-balance"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HR_Balance</bpmn:incoming>
      <bpmn:outgoing>Flow_Balance_Notify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ApprovedNotify" name="Notify Employee: Leave Approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-leave-approval"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Balance_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Approved" name="Leave Approved">
      <bpmn:incoming>Flow_Approved_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_LeaveRequest" targetRef="Task_SubmitLeave"/>
    <bpmn:sequenceFlow id="Flow_Submit_Decision" sourceRef="Task_SubmitLeave" targetRef="Task_LeaveDecision"/>
    <bpmn:sequenceFlow id="Flow_DecisionGateway" sourceRef="Task_LeaveDecision" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_Insufficient" name="INSUFFICIENT_BALANCE" sourceRef="Gateway_Decision" targetRef="Task_InsufficientBalance"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=leaveDecision.decision = "INSUFFICIENT_BALANCE"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApproved" name="AUTO_APPROVE" sourceRef="Gateway_Decision" targetRef="Task_HRRecord"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=leaveDecision.decision = "AUTO_APPROVE"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerReview" name="MANAGER_REVIEW" sourceRef="Gateway_Decision" targetRef="Task_ManagerApproval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=leaveDecision.decision = "MANAGER_REVIEW"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Insufficient_End" sourceRef="Task_InsufficientBalance" targetRef="End_Insufficient"/>
    <bpmn:sequenceFlow id="Flow_ManagerGateway" sourceRef="Task_ManagerApproval" targetRef="Gateway_ManagerDecision"/>
    <bpmn:sequenceFlow id="Flow_ManagerRejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_ManagerRejectedNotify"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "REJECTED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerApproved" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_HRRecord"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerRejected_End" sourceRef="Task_ManagerRejectedNotify" targetRef="End_ManagerRejected"/>
    <bpmn:sequenceFlow id="Flow_HR_Balance" sourceRef="Task_HRRecord" targetRef="Task_UpdateBalance"/>
    <bpmn:sequenceFlow id="Flow_Balance_Notify" sourceRef="Task_UpdateBalance" targetRef="Task_ApprovedNotify"/>
    <bpmn:sequenceFlow id="Flow_Approved_End" sourceRef="Task_ApprovedNotify" targetRef="End_Approved"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_EmployeeLeave">
    <bpmndi:BPMNPlane id="BPMNPlane_EmployeeLeave" bpmnElement="EmployeeLeaveApproval">
      <bpmndi:BPMNShape id="StartEvent_LeaveRequest_di" bpmnElement="StartEvent_LeaveRequest"><dc:Bounds x="80" y="300" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitLeave_di" bpmnElement="Task_SubmitLeave"><dc:Bounds x="160" y="280" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LeaveDecision_di" bpmnElement="Task_LeaveDecision"><dc:Bounds x="380" y="280" width="190" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision"><dc:Bounds x="630" y="295" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InsufficientBalance_di" bpmnElement="Task_InsufficientBalance"><dc:Bounds x="720" y="100" width="230" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Insufficient_di" bpmnElement="End_Insufficient"><dc:Bounds x="1010" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerApproval_di" bpmnElement="Task_ManagerApproval"><dc:Bounds x="720" y="280" width="210" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision"><dc:Bounds x="990" y="295" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerRejectedNotify_di" bpmnElement="Task_ManagerRejectedNotify"><dc:Bounds x="1080" y="400" width="230" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ManagerRejected_di" bpmnElement="End_ManagerRejected"><dc:Bounds x="1370" y="422" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRRecord_di" bpmnElement="Task_HRRecord"><dc:Bounds x="1080" y="250" width="190" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_di" bpmnElement="Task_UpdateBalance"><dc:Bounds x="1320" y="250" width="210" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApprovedNotify_di" bpmnElement="Task_ApprovedNotify"><dc:Bounds x="1580" y="250" width="210" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved"><dc:Bounds x="1840" y="272" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit"><di:waypoint x="116" y="318"/><di:waypoint x="160" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Decision_di" bpmnElement="Flow_Submit_Decision"><di:waypoint x="330" y="320"/><di:waypoint x="380" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DecisionGateway_di" bpmnElement="Flow_DecisionGateway"><di:waypoint x="570" y="320"/><di:waypoint x="630" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Insufficient_di" bpmnElement="Flow_Insufficient"><di:waypoint x="655" y="295"/><di:waypoint x="835" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproved_di" bpmnElement="Flow_AutoApproved"><di:waypoint x="680" y="320"/><di:waypoint x="1080" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerReview_di" bpmnElement="Flow_ManagerReview"><di:waypoint x="655" y="345"/><di:waypoint x="825" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Insufficient_End_di" bpmnElement="Flow_Insufficient_End"><di:waypoint x="950" y="140"/><di:waypoint x="1010" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerGateway_di" bpmnElement="Flow_ManagerGateway"><di:waypoint x="930" y="320"/><di:waypoint x="990" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerRejected_di" bpmnElement="Flow_ManagerRejected"><di:waypoint x="1015" y="345"/><di:waypoint x="1195" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproved_di" bpmnElement="Flow_ManagerApproved"><di:waypoint x="1040" y="320"/><di:waypoint x="1080" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerRejected_End_di" bpmnElement="Flow_ManagerRejected_End"><di:waypoint x="1310" y="440"/><di:waypoint x="1370" y="440"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HR_Balance_di" bpmnElement="Flow_HR_Balance"><di:waypoint x="1270" y="290"/><di:waypoint x="1320" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Balance_Notify_di" bpmnElement="Flow_Balance_Notify"><di:waypoint x="1530" y="290"/><di:waypoint x="1580" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_End_di" bpmnElement="Flow_Approved_End"><di:waypoint x="1790" y="290"/><di:waypoint x="1840" y="290"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
