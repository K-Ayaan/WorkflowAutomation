    <bpmn:task id="Task_37" name="Send Rejection Notification"/>
    <bpmn:endEvent id="End_33" name="Process Ends"/>
    <bpmn:task id="Task_38" name="Generate Offer Letter"/>
    <bpmn:task id="Task_39" name="Send Offer Letter to Candidate"/>
    <bpmn:endEvent id="End_34" name="Process Ends"/>
    <bpmn:sequenceFlow id="G31" sourceRef="StartEvent_3" targetRef="Task_31"/>
