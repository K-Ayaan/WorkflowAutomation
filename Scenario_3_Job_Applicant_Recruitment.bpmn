    <bpmn:exclusiveGateway id="Gateway_32" name="Technical Interview Passed?" default="G38"/>
    <bpmn:task id="Task_35" name="Send Rejection Notification"/>
    <bpmn:endEvent id="End_32" name="Process Ends"/>
    <bpmn:task id="Task_36" name="Schedule HR / Managerial Round"/>
