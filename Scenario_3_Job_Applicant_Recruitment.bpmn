  <bpmn:process id="JobApplicantRecruitment" name="Job Applicant Recruitment Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_3" name="Job Application Submitted"/>
    <bpmn:task id="Task_31" name="Screen Application Against Eligibility Criteria"/>
    <bpmn:exclusiveGateway id="Gateway_31" name="Meets Eligibility Criteria?" default="G33"/>
    <bpmn:task id="Task_32" name="Send Rejection Notification"/>
    <bpmn:endEvent id="End_31" name="Process Ends"/>
    <bpmn:task id="Task_33" name="Schedule Technical Interview"/>
