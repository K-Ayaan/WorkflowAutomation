  <bpmn:process id="HotelRoomReservation" name="Hotel Room Reservation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Booking Request"/>
    <bpmn:task id="Task_1" name="Check Room Availability"/>
    <bpmn:exclusiveGateway id="Gateway_1" name="Rooms Available?" default="Flow_3"/>
    <bpmn:task id="Task_2" name="Notify Guest: No Rooms Available"/>
    <bpmn:endEvent id="End_1" name="Reservation Ends"/>
    <bpmn:task id="Task_3" name="Request Advance / Deposit Payment"/>
    <bpmn:exclusiveGateway id="Gateway_2" name="Payment Successful?" default="Flow_7"/>
    <bpmn:task id="Task_4" name="Notify Guest: Payment Failed"/>
    <bpmn:endEvent id="End_2" name="Reservation Ends"/>
    <bpmn:task id="Task_5" name="Confirm Booking &amp; Generate Reference"/>
    <bpmn:task id="Task_6" name="Send Booking Confirmation Email"/>
    <bpmn:endEvent id="End_3" name="Booking Process Ends"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_1" targetRef="Task_2" name="No"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_1" targetRef="Task_3" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_3" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_2" targetRef="Task_4" name="No"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_4" targetRef="End_2"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_2" targetRef="Task_5" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_5" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_6" targetRef="End_3"/>
  </bpmn:process>
