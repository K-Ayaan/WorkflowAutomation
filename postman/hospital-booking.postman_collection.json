                "exec": [
                  "        const names = pm.response.json().items.map((i) => i.name).sort();\r",
                  "        console.log('child variables (propagation OFF):', names.join(', '));\r",
                  "        pm.test('child only sees recipientId + messageText (plus its own result)', () => {\r",
                  "          pm.expect(names).to.eql(['messageText', 'notificationStatus', 'recipientId', 'telegramMessageId']);\r",
                  "        });\r"
                ]
              }
            }
