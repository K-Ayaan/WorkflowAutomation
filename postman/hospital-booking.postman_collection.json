{
  "info": {
    "name": "Exercise 8 – Hospital appointment booking (Camunda 8)",
    "description": "Deploys send-notification, slot_decision, hospital-booking and hospital-booking-propagate-all to a local Camunda 8.10 orchestration cluster, runs the three required test cases plus the propagation comparison, and verifies the results through the v2 REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "telegramMockUrl",
      "value": "http://localhost:8090"
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "Cluster topology",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/topology",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "topology"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        pm.test('broker healthy', () => {\r",
                  "          pm.response.to.have.status(200);\r",
                  "          pm.expect(pm.response.json().brokers[0].partitions[0].health).to.eql('healthy');\r",
                  "        });\r"
                ]
              }
            }
          ]
        },
        {
          "name": "Deploy BPMN + DMN",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/deployments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "deployments"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resources",
                  "type": "file",
                  "src": "bpmn/send-notification.bpmn"
                },
                {
                  "key": "resources",
                  "type": "file",
                  "src": "dmn/slot_decision.dmn"
                },
                {
                  "key": "resources",
                  "type": "file",
                  "src": "bpmn/hospital-booking.bpmn"
                },
                {
                  "key": "resources",
                  "type": "file",
                  "src": "bpmn/hospital-booking-propagate-all.bpmn"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        pm.test('deployed 3 processes and 1 decision', () => {\r",
                  "          pm.response.to.have.status(200);\r",
                  "          const d = pm.response.json().deployments;\r",
                  "          const ids = d.map((x) => (x.processDefinition || x.decisionDefinition || {}).processDefinitionId || (x.decisionDefinition || {}).decisionDefinitionId).filter(Boolean);\r",
                  "          pm.expect(ids).to.include.members(['send-notification', 'slot_decision', 'hospital-booking', 'hospital-booking-propagate-all']);\r",
                  "        });\r"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Case – Cardiology bookedCount 3 (booking succeeds)",
      "item": [
        {
          "name": "Start booking P-1001",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/process-instances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "process-instances"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"processDefinitionId\": \"hospital-booking\",\n  \"variables\": {\n    \"patientId\": \"P-1001\",\n    \"patientName\": \"Asha Verma\",\n    \"department\": \"Cardiology\",\n    \"preferredSlot\": \"2026-11-03 10:30\",\n    \"bookedCount\": 3,\n    \"appointmentWaitTime\": \"PT20S\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('instance created', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('case1Key', pm.response.json().processInstanceKey);",
                  "console.log('case1Key =', pm.response.json().processInstanceKey);"
                ]
              }
            }
          ]
        }
      ]
    },
