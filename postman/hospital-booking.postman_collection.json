    {
      "name": "5 Verify results",
      "item": [
        {
          "name": "Case 1 parent completed via booking path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/variables/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "variables",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"processInstanceKey\": \"{{case1Key}}\",\n    \"scopeKey\": \"{{case1Key}}\"\n  },\n  \"page\": {\n    \"limit\": 100\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 30000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        const v = Object.fromEntries(pm.response.json().items.map((i) => [i.name, JSON.parse(i.value)]));\r",
                  "        pm.test('slotStatus AVAILABLE, BOOKED, confirmation SENT', () => {\r",
                  "          pm.expect(v.slotStatus).to.eql('AVAILABLE');\r",
                  "          pm.expect(v.bookingStatus).to.eql('BOOKED');\r",
                  "          pm.expect(v.bookingRef).to.eql('APT-CARD-P-1001');\r",
                  "          pm.expect(v.bookedCount).to.eql(4);\r",
                  "          pm.expect(v.confirmationStatus).to.eql('SENT');\r",
                  "        });\r",
                  "        pm.test('child-only variables did not leak into the parent', () => {\r",
                  "          pm.expect(v).to.not.have.property('recipientId');\r",
                  "          pm.expect(v).to.not.have.property('messageText');\r",
                  "        });\r"
                ]
              }
            }
          ]
        },
        {
          "name": "Case 1 parent state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/process-instances/{{case1Key}}",
              "host": [
                "{{baseUrl}}"
