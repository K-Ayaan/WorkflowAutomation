              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "        const items = pm.response.json().items;\r",
                  "        pm.test('one completed send-notification child', () => {\r",
                  "          pm.expect(items.length).to.eql(1);\r",
                  "          pm.expect(items[0].processDefinitionId).to.eql('send-notification');\r",
                  "          pm.expect(items[0].state).to.eql('COMPLETED');\r",
                  "        });\r",
                  "        pm.collectionVariables.set('case1ChildKey', items[0].processInstanceKey);\r"
                ]
              }
            }
          ]
        },
