    <bpmn:sequenceFlow id="F25" sourceRef="Gateway_21" targetRef="Task_23" name="Yes"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_23" targetRef="Gateway_22"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Gateway_22" targetRef="Task_24" name="No"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Task_24" targetRef="End_22"/>
    <bpmn:sequenceFlow id="F29" sourceRef="Gateway_22" targetRef="Task_25" name="Yes"/>
    <bpmn:sequenceFlow id="F30" sourceRef="Task_25" targetRef="Gateway_23"/>
    <bpmn:sequenceFlow id="F31" sourceRef="Gateway_23" targetRef="Task_28" name="No"/>
    <bpmn:sequenceFlow id="F32" sourceRef="Task_28" targetRef="End_24"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Gateway_23" targetRef="Task_26" name="Yes"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Task_26" targetRef="Task_27"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Task_27" targetRef="End_23"/>
  </bpmn:process>
