  <bpmn:process id="LoanApplicationProcessing" name="Loan Application Processing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_2" name="Loan Application Submitted"/>
    <bpmn:task id="Task_21" name="Verify Documents &amp; Credit Score"/>
    <bpmn:exclusiveGateway id="Gateway_21" name="Documents Valid?" default="F23"/>
    <bpmn:task id="Task_22" name="Reject Application &amp; Notify Customer"/>
    <bpmn:endEvent id="End_21" name="Process Ends"/>
    <bpmn:task id="Task_23" name="Check Eligibility: Credit Score &amp; Income"/>
    <bpmn:exclusiveGateway id="Gateway_22" name="Applicant Eligible?" default="F27"/>
    <bpmn:task id="Task_24" name="Send Rejection Notification"/>
    <bpmn:endEvent id="End_22" name="Process Ends"/>
    <bpmn:task id="Task_25" name="Forward to Loan Officer"/>
    <bpmn:exclusiveGateway id="Gateway_23" name="Loan Approved?" default="F31"/>
    <bpmn:task id="Task_26" name="Disburse Loan Amount"/>
    <bpmn:task id="Task_27" name="Send Approval Notification"/>
    <bpmn:endEvent id="End_23" name="Process Ends"/>
    <bpmn:task id="Task_28" name="Send Rejection Notification"/>
    <bpmn:endEvent id="End_24" name="Process Ends"/>
    <bpmn:sequenceFlow id="F21" sourceRef="StartEvent_2" targetRef="Task_21"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_21" targetRef="Gateway_21"/>
